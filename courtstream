<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Court Stream Troubleshooter v1.0.0</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script data-cfasync="false" src="https://video.ibm.com/embed-api/v1/ustream-embedapi.min.js"></script>
    <style>
        :root {
            --bg-color: #0d1117; 
            --card-bg: #161b22; 
            --border-color: #30363d;
            --text-main: #ffffff; 
            --text-dim: #8b949e; 
            --plex-orange: #e5a00d;
        }

        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: var(--bg-color); 
            color: var(--text-main); 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        }

        /* THE BOX (Dashboard Tile Simulation) */
        .counter-item { 
            background: var(--card-bg); 
            border: 1px solid var(--border-color); 
            border-radius: 10px; 
            height: 150px; 
            width: 330px; 
            position: relative; 
            overflow: hidden; 
            border-top: 3px solid var(--plex-orange);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        /* THE WRAPPER (The Mask) */
        .court-wrapper { 
            width: 100%; 
            height: 100%; 
            overflow: hidden; 
            position: relative; 
            background: #000; 
        }

        /* --- THE ALIGNMENT TARGET --- */
        .court-iframe { 
            width: 1200px; 
            height: 675px; 
            border: none; 
            position: absolute; 
            
            /* v1.0.0 DEFAULT VALUES - NUDGE THESE */
            top: -80px;      
            left: 580px;     
            transform: scale(0.45); 
            
            transform-origin: 0 0;
            pointer-events: none; 
        }

        /* UI OVERLAYS */
        .status-container { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            position: absolute; 
            bottom: 12px; 
            left: 12px; 
            background: rgba(0,0,0,0.7); 
            padding: 4px 10px; 
            border-radius: 20px; 
            border: 1px solid var(--border-color); 
            z-index: 30;
        }
        .dot { height: 8px; width: 8px; background-color: #484f58; border-radius: 50%; }
        .dot.live { background-color: #ff0000; box-shadow: 0 0 8px #ff0000; }
        .status-text { font-size: 10px; font-weight: bold; color: var(--text-dim); }
        
        .ver-tag {
            margin-top: 20px;
            font-size: 12px;
            color: var(--text-dim);
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <div class="counter-item">
        <div class="court-wrapper">
            <iframe id="court-player" class="court-iframe" src="https://video.ibm.com/embed/23891775?showtitle=false&volume=0"></iframe>
            
            <div style="position: absolute; top: 10px; left: 15px; z-index: 30; text-shadow: 2px 2px 4px #000;">
                <h4 style="margin: 0; font-size: 14px; color: #fff;">Court Stream</h4>
                <p style="font-size: 11px; color: var(--plex-orange); margin: 0;">Troubleshooter</p>
            </div>

            <div class="status-container">
                <span id="court-dot" class="dot"></span>
                <span id="court-text" class="status-text">SYNCING</span>
            </div>
        </div>
    </div>

    <div class="ver-tag">BUILD VERSION: v1.0.0</div>

    <script>
        function monitor() {
            if (typeof UstreamEmbed === 'undefined') { setTimeout(monitor, 500); return; }
            const viewer = UstreamEmbed('court-player');
            viewer.addListener('live', (isLive) => {
                const active = (isLive === true || isLive === 'live');
                document.getElementById('court-dot').className = active ? 'dot live' : 'dot';
                document.getElementById('court-text').innerText = active ? "LIVE NOW" : "OFF AIR";
                document.getElementById('court-text').style.color = active ? "#ff0000" : "#8b949e";
            });
        }
        window.addEventListener('load', monitor);
    </script>
</body>
</html>
